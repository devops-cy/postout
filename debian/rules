#!/usr/bin/make -f

%:
	dh $@ --with python3

override_dh_auto_clean:
	:

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	:

override_dh_auto_install:
	install -d debian/postout/usr/share/postout/postout
	install -m 0644 src/postout/__init__.py debian/postout/usr/share/postout/postout/
	install -m 0644 src/postout/__main__.py debian/postout/usr/share/postout/postout/
	install -m 0644 src/postout/cli.py debian/postout/usr/share/postout/postout/
	install -d debian/postout/usr/bin
	install -m 0755 debian/postout-launcher debian/postout/usr/bin/postout

override_dh_python3:
	dh_python3 /usr/share/postout

override_dh_builddeb:
	dh_builddeb -- -Zxz
